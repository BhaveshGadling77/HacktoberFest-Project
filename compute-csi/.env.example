# Database
POSTGRES_PASSWORD=csi_dev_password
DATABASE_URL=sqlite+aiosqlite:///./compute_csi.db

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=compute-csi-queue

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Kepler (requires Kubernetes + eBPF support)
KEPLER_ENABLED=false

# Gemma (optional AI analysis)
GEMMA_ENDPOINT=
GEMMA_API_KEY=
GEMMA_MODEL=gemma2-2b-it

# JarvisLabs (optional GPU inference)
JARVISLABS_API_KEY=
JARVISLABS_INSTANCE_URL=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
